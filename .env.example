# ─── App ───────────────────────────────────────────
APP_NAME=app-entrenos
APP_ENV=development          # development | staging | production
DEBUG=true                   # false en staging y production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Base de datos (docker compose) ────────────────
POSTGRES_USER=entrenos
POSTGRES_PASSWORD=           # Generar con: openssl rand -hex 16
POSTGRES_DB=entrenos
# Para ejecutar el backend/tests fuera de Docker (puerto publicado 5433):
DATABASE_URL=postgresql+psycopg://entrenos:CAMBIAR@127.0.0.1:5433/entrenos

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380/0

# ─── Auth / JWT ────────────────────────────────────
JWT_SECRET_KEY=              # Generar con: openssl rand -hex 32
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── Storage — .FIT originales (volumen local; S3 compatible en el futuro)
STORAGE_DIR=./data/storage

# ─── Garmin ────────────────────────────────────────
# Las credenciales de Garmin NO van aquí: se introducen una vez y solo se guardan los tokens.
GARMIN_TOKEN_DIR=/data/garmin-tokens
# Clave para cifrar en la BD los tokens de Garmin y las claves de API de los asistentes de IA. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_KEY=
# Opcional: clave genérica para esos secretos; si está vacía se usa GARMIN_TOKEN_KEY.
SECRETS_KEY=

# ─── Email (invitaciones, recuperar contraseña, registro con aprobación) ──
# URL pública de la web, para los enlaces de los emails.
APP_PUBLIC_URL=http://localhost:3000
# auto = SMTP si hay SMTP_HOST, si no desactivado | smtp | file (guarda .eml en STORAGE_DIR/outbox) | disabled
EMAIL_BACKEND=auto
# Cualquier SMTP: Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:465, ssl), el de tu dominio…
# En local con Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none (bandeja en http://127.0.0.1:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KTrain <no-reply@tudominio.com>
SMTP_SECURITY=starttls          # starttls | ssl | none

# ─── Autoregistro ────────────────────────────────────
# El registro sin invitación (Admin → Registro) exige SMTP para confirmar el email.
# Captcha opcional (Cloudflare Turnstile, gratis): https://dash.cloudflare.com → Turnstile. Sin claves, desactivado.
# Claves de prueba de Cloudflare para local: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Rutas ─────────────────────────────────────────
# Planificador de rutas (Plan → Rutas). Por defecto BRouter, sin clave (servidor público brouter.de).
# Con un BRouter propio: BROUTER_URL=http://brouter:17777/brouter
ROUTE_ENGINE=brouter
BROUTER_URL=https://brouter.de/brouter
# Solo con ROUTE_ENGINE=ors: clave gratuita de https://openrouteservice.org
ORS_API_KEY=

# ─── Asistente IA ────────────────────────────────────
# Cada usuario pone su propia clave (ChatGPT, Gemini o Claude) en Ajustes. Máximo de preguntas por usuario y día:
CHAT_DAILY_LIMIT=100

# ─── Red local ───────────────────────────────────────
# 127.0.0.1 = solo este PC (por defecto). 0.0.0.0 = también otros dispositivos de tu wifi (móvil).
WEB_BIND=127.0.0.1

# ─── Frontend (Next.js) ────────────────────────────
# La web usa /api en su mismo origen (proxy). Solo para `npm run dev` fuera de Docker:
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=KTrain
